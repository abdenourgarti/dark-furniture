# --- Resend (contact form) --------------------------------------------------
# Create a key at https://resend.com/api-keys and copy it into .env.local
RESEND_API_KEY=

# Where quote requests are delivered.
CONTACT_TO=dark.furnitures@gmail.com

# Sender address.
#
# Resend will NOT let you send from an address you do not own. Two options:
#
#   1. Before you verify a domain, keep the onboarding sender below. It only
#      delivers to the email address that owns the Resend account, so sign up
#      with dark.furnitures@gmail.com for the form to work straight away.
#
#   2. Once a domain is verified at https://resend.com/domains (add the DKIM
#      and SPF records it gives you), switch to your own address, for example:
#      CONTACT_FROM="Dark Furniture <contact@darkfurniture.dz>"
#
CONTACT_FROM="Dark Furniture <onboarding@resend.dev>"
